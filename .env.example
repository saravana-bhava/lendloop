# -----------------------------------------------------------------------------
# LendLoop Environment Configuration
# -----------------------------------------------------------------------------

# Convex Deployment
NEXT_PUBLIC_CONVEX_URL="https://your-convex-deployment.convex.cloud"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_JWT_ISSUER_DOMAIN="https://your-clerk-domain.clerk.accounts.dev"

# n8n Automation Webhooks & HMAC Security
# Shared secret used to sign outbound webhooks from Convex and verify incoming write-backs
N8N_WEBHOOK_URL="http://localhost:5678/webhook/borrow-request"
N8N_WEBHOOK_SECRET="replace-with-a-high-entropy-64-character-hex-secret"

# Internal Convex API Secret (used by n8n to call Convex HTTP endpoints)
CONVEX_INTERNAL_API_SECRET="replace-with-a-secure-internal-api-secret"
